       # Only looks for full string matches, substrings within a longer string are not
       # considered.
       #
+      # The Windows device name `NUL` is matched case sensitively (only the uppercase
+      # `NUL` and `NUL:` are considered), so that unrelated strings such as `'nul'` are
+      # not flagged. The Unix path `/dev/null` is matched case insensitively.
+      #
       # NOTE: Uses inside arrays and hashes are ignored.
       #
       # @safety
@@ -39,7 +43,7 @@ module RuboCop
       class FileNull < Base
         extend AutoCorrector
 
-        REGEXP = %r{\A(/dev/null|NUL:?)\z}i.freeze
+        REGEXP = Regexp.union(%r{\A/dev/null\z}i, /\ANUL:?\z/).freeze
         MSG = 'Use `File::NULL` instead of `%<source>s`.'
 
         def on_str(node)
