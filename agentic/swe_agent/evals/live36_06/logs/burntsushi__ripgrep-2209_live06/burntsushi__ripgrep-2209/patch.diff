+            // The replacement logic here is copied (and adapted) from the
+            // default `Matcher::replace_with_captures_at` implementation. We
+            // can't use that method directly because it has no way of
+            // expressing an end bound for the search. In multi-line mode, we
+            // let the regex engine search a little beyond the end of the match
+            // (see above) to account for look-around. But we don't want matches
+            // that begin at or beyond the end of the range to be reported, nor
+            // do we want the content beyond the end of the range to be copied
+            // into the replacement. Otherwise, the replacement can wind up
+            // containing content that was never part of the original match.
+            //
+            // See: https://github.com/BurntSushi/ripgrep/issues/1893
+            //
+            // Note that in the single line (non-multi-line) case, the subject
+            // may have been trimmed above to remove a trailing line terminator,
+            // in which case the subject can be shorter than the end of the
+            // range. So we cap the end of the final copy at the subject length.
+            let end = range.end.min(subject.len());
+            let mut last_match = range.start;
