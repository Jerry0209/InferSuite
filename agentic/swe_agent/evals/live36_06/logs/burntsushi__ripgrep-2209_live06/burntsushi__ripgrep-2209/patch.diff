                     },
                 )
                 .map_err(io::Error::error_message)?;
+            // A match found above (e.g., because of look-around extending the
+            // match beyond the range) can push `last_match` past `end`. Cap it
+            // so that we never copy content beyond the end of the range.
+            let last_match = last_match.min(end);
+            dst.extend(&subject[last_match..end]);
