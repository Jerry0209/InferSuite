                             |name| matcher.capture_index(name),
@@ -96,12 +120,17 @@ impl<M: Matcher> Replacer<M> {
                             replacement,
                             dst,
                         );
-                        let end = dst.len();
-                        matches.push(Match::new(start, end));
+                        let match_end = dst.len();
+                        matches.push(Match::new(start, match_end));
