-                    dst,
-                    |caps, dst| {
+                    |caps| {
+                        let m = caps.get(0).unwrap();
+                        if m.start() >= end {
+                            return false;
+                        }
+                        dst.extend(&subject[last_match..m.start()]);
+                        last_match = m.end();
                         let start = dst.len();
