diff --git a/src/objects/Line.js b/src/objects/Line.js
index e359bcfb29..ddc0e016c3 100644
--- a/src/objects/Line.js
+++ b/src/objects/Line.js
@@ -35,6 +35,21 @@ class Line extends Object3D {
 		super.copy( source, recursive );
 
 		this.material = source.material;
+
+		if ( Array.isArray( source.material ) ) {
+
+			const materials = [];
+
+			for ( let i = 0, l = source.material.length; i < l; i ++ ) {
+
+				materials.push( source.material[ i ] );
+
+			}
+
+			this.material = materials;
+
+		}
+
 		this.geometry = source.geometry;
 
 		return this;
