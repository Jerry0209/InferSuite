       typename FormatContext::iterator {
     using base = formatter<typename std::decay<Arg>::type, Char>;
-    auto out = base().format(arg, ctx);
+    auto parse_ctx = basic_format_parse_context<Char>(format_str_);
+    base f;
+    f.parse(parse_ctx);
+    auto out = f.format(arg, ctx);
     if (sizeof...(Args) > 0) {
       out = std::copy(value.sep.begin(), value.sep.end(), out);
       ctx.advance_to(out);
@@ -668,6 +688,8 @@ struct formatter<tuple_join_view<Char, T...>, Char> {
