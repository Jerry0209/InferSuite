+    # Returns the length of the name / id that matches the filename.
+    # This is used to prefer more specific matches (e.g. "iPhone 13 Pro" over "iPhone 13")
+    # when multiple devices match the filename with the same priority.
+    def matching_name_length(filename)
+      [formatted_name_without_apple, id].select { |name| !name.nil? && filename.include?(name) }.map(&:length).max || 0
+    end
+
     def self.detect_device(path, platform)
       size = FastImage.size(path)
 
