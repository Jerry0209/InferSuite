+        # if the priority is the same, the device with the longer matching name / id wins (e.g. "iPhone 13 Pro" over "iPhone 13")
+        if (filename.include?(device.formatted_name_without_apple) || filename.include?(device.id)) && (filename_device.nil? || filename_device.priority < device.priority || (filename_device.priority == device.priority && device.matching_name_length(filename) > filename_device.matching_name_length(filename)))
