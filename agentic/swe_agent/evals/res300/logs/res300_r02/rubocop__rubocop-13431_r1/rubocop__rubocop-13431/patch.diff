diff --git a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
index b00156373..6c8851822 100644
--- a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
+++ b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
@@ -27,12 +27,19 @@ module RuboCop
         KIND = 'method'
 
         def on_def(node)
-          check(node, node.body)
+          check(node, node.body, adjusted_first_line: first_line(node))
         end
         alias on_defs on_def
 
         private
 
+        def first_line(node)
+          args = node.arguments
+          return node.first_line unless args.source_range
+
+          args.last_line > node.first_line ? args.last_line : node.first_line
+        end
+
         def style
           :no_empty_lines
         end
