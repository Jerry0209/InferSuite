+                    // the end of the call.
+                    let value_end = parenthesized_range(
+                        attribute.value.as_ref().into(),
+                        attribute.into(),
+                        checker.comment_ranges(),
+                        checker.locator().contents(),
+                    )
+                    .unwrap_or_else(|| attribute.value.range())
+                    .end();
+                    let edit = Edit::deletion(value_end, call.end());
