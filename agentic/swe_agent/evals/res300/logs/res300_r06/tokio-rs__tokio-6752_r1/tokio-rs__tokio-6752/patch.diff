@@ -1,3 +1,13 @@
+# Unreleased
+
+### Fixed
+
+- time: wake the stored waker when the last item is removed from a `DelayQueue`
+  so that a concurrent `poll_expired` is notified that the queue is now empty
+  ([#6748])
+
+[#6748]: https://github.com/tokio-rs/tokio/pull/6748
+
 # 0.7.11 (May 4th, 2024)
 
 This release updates the MSRV to 1.63. ([#6126])
diff --git a/tokio-util/src/time/delay_queue.rs b/tokio-util/src/time/delay_queue.rs
index 2b33e361..37fa9313 100644
--- a/tokio-util/src/time/delay_queue.rs
+++ b/tokio-util/src/time/delay_queue.rs
@@ -759,10 +759,21 @@ impl<T> DelayQueue<T> {
 
         let next_deadline = self.next_deadline();
         if prev_deadline != next_deadline {
-            match (next_deadline, &mut self.delay) {
-                (None, _) => self.delay = None,
-                (Some(deadline), Some(delay)) => delay.as_mut().reset(deadline),
-                (Some(deadline), None) => self.delay = Some(Box::pin(sleep_until(deadline))),
+            match next_deadline {
+                None => {
+                    self.delay = None;
+                    // The queue no longer has any pending deadlines. Wake up
+                    // any task that is currently polling the queue so that it
+                    // can observe the empty queue and return `Poll::Ready(None)`
+                    // instead of waiting indefinitely on the now-dropped timer.
+                    if let Some(waker) = self.waker.take() {
+                        waker.wake();
+                    }
+                }
+                Some(deadline) => match &mut self.delay {
+                    Some(delay) => delay.as_mut().reset(deadline),
+                    None => self.delay = Some(Box::pin(sleep_until(deadline))),
+                },
             }
         }
 
