diff --git a/docs/querying/operators.md b/docs/querying/operators.md
index d998d7326..5f7f96ea4 100644
--- a/docs/querying/operators.md
+++ b/docs/querying/operators.md
@@ -21,6 +21,7 @@ The following binary arithmetic operators exist in Prometheus:
 * `/` (division)
 * `%` (modulo)
 * `^` (power/exponentiation)
+* `atan2` (2-argument arctangent: calculates the arc tangent of `y/x` using the signs of the two to determine the return value)
 
 Binary arithmetic operators are defined between scalar/scalar, vector/scalar,
 and vector/vector value pairs.
diff --git a/promql/engine.go b/promql/engine.go
index 3b1d35757..e7af85615 100644
--- a/promql/engine.go
+++ b/promql/engine.go
@@ -2073,6 +2073,8 @@ func scalarBinop(op parser.ItemType, lhs, rhs float64) float64 {
 		return math.Pow(lhs, rhs)
 	case parser.MOD:
 		return math.Mod(lhs, rhs)
+	case parser.ATAN2:
+		return math.Atan2(lhs, rhs)
 	case parser.EQLC:
 		return btos(lhs == rhs)
 	case parser.NEQ:
@@ -2104,6 +2106,8 @@ func vectorElemBinop(op parser.ItemType, lhs, rhs float64) (float64, bool) {
 		return math.Pow(lhs, rhs), true
 	case parser.MOD:
 		return math.Mod(lhs, rhs), true
+	case parser.ATAN2:
+		return math.Atan2(lhs, rhs), true
 	case parser.EQLC:
 		return lhs, lhs == rhs
 	case parser.NEQ:
@@ -2411,7 +2415,7 @@ func btos(b bool) float64 {
 // result of the op operation.
 func shouldDropMetricName(op parser.ItemType) bool {
 	switch op {
-	case parser.ADD, parser.SUB, parser.DIV, parser.MUL, parser.POW, parser.MOD:
+	case parser.ADD, parser.SUB, parser.DIV, parser.MUL, parser.POW, parser.MOD, parser.ATAN2:
 		return true
 	default:
 		return false
