+import lombok.NonNull;
+public record NonNullOnRecordPrimitiveArray(String name, byte bytes) {
+/* Implicit */  private final String name;
+/* Implicit */  private final byte @NonNull [] bytes;
+  public @java.lang.SuppressWarnings("all") NonNullOnRecordPrimitiveArray(@NonNull String name, byte @NonNull [] bytes) {
+    super();
+    if ((name == null))
+        {
+          throw new java.lang.NullPointerException("name is marked non-null but is null");
+        }
+    if ((bytes == null))
+        {
+          throw new java.lang.NullPointerException("bytes is marked non-null but is null");
+        }
+    this.name = name;
+    this.bytes = bytes;
+  }
+}
