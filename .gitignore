# hardened-rerun campaigns: figure-critical raw data IS tracked so the repo is
# self-sufficient for regenerating + auditing every figure. Only the heavy perf record
# binaries stay local (their derived comm/dso/ksym/leaf/lane tables ARE tracked), plus
# the one >100MB traj (tracked as .traj.gz — decompress after clone).
local_agents/*_clean/data/**/rec_*.data
local_agents/SWE_clean/data/glm_swe_sympy/run_1/traj/sympy__sympy-14248/sympy__sympy-14248.traj
local_agents/SWE_clean/*.log
local_agents/OC_clean/*.log
# archived campaign raw data stays local too
archive/**/data/

# superseded 40-min soft-iso campaign raw data (perf-record captures too large for GitHub)
local_agents/superseded_40min/data/

# Claude session scratch/transcript (not a durable doc)
further_check.md
# multilingual language-pilot campaign (ML_multiling): same policy as *_clean — bank
# everything needed to regenerate/audit figures; exclude only heavy perf records and logs
local_agents/ML_multiling/data/**/rec_*.data
local_agents/ML_multiling/data/glm_swe_prometheus/run_1/traj/prometheus__prometheus-9248/prometheus__prometheus-9248.traj

# kit runtime state (gate markers, dryrun outputs) — per-machine, never committed
local_agents/kit/campaign/.state/
# behavioural-probe trajectory over GitHub's 100 MB hard limit (same policy as the sympy and
# prometheus trajectories above; the realized label it supports is banked in
# sampling_frame/behavior_ledger.tsv and docs/reports/17)
local_agents/ML_multiling/data/glm_swe_hashicorp-bE/run_1/traj/hashicorp__terraform-35543/hashicorp__terraform-35543.traj

